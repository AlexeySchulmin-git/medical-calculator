# ── База данных (PostgreSQL / Supabase) ───────────────
# Supabase: Settings → Database → Connection string → URI
# Пример: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/medical_calculator

# ── Email (Resend) ────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
MANAGER_EMAIL=your@email.com

# ── Telegram-бот ─────────────────────────────────────
# 1. Создайте бота через @BotFather → получите токен
# 2. Напишите боту любое сообщение
# 3. Откройте https://api.telegram.org/bot<TOKEN>/getUpdates
#    и найдите "chat":{"id": XXXXXXXX} — это ваш CHAT_ID
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# ── Google Sheets ─────────────────────────────────────
# Вариант 1 (продакшн/Railway): вставьте содержимое JSON-ключа одной строкой
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}
#
# Вариант 2 (локально): укажите путь к файлу
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json
GOOGLE_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
GOOGLE_SHEET_NAME=Заявки

# ── DaData ────────────────────────────────────────────
DADATA_API_KEY=your_dadata_api_key
DADATA_SECRET_KEY=your_dadata_secret_key
