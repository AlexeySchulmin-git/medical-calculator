#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Обновляем CODEINDEX перед коммитом
echo "🔄 Обновление CODEINDEX..."
npm run index

# Проверяем, изменился ли файл
if git diff --quiet docs/CODEINDEX.md; then
  echo "✅ CODEINDEX не изменился"
else
  echo "✅ CODEINDEX обновлён, добавляем в коммит"
  git add docs/CODEINDEX.md
fi
